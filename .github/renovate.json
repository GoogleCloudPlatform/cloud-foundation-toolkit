{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "mergeConfidence:all-badges",
    "config:recommended",
    ":semanticCommits",
    ":preserveSemverRanges",
    "helpers:pinGitHubActionDigests",
    ":enablePreCommit"
  ],
  "minimumReleaseAge": "7 days",
  "ignorePaths": [
    "cli/testdata/**",
    "tflint-ruleset-blueprint/rules/testdata/**"
  ],
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "type:security"
    ],
    "minimumReleaseAge": null,
    "additionalBranchPrefix": "",
    "groupName": "{{#if packageFileDir}}{{{packageFileDir}}} security deps{{else}}root security deps{{/if}}",
    "groupSlug": "{{#if packageFileDir}}{{{packageFileDir}}}-security-deps{{else}}root-security-deps{{/if}}"
  },
  "separateMajorMinor": false,
  "additionalBranchPrefix": "{{#if parentDir}}{{parentDir}}-{{/if}}",
  "constraints": {
    "go": "< 1.27",
    "%goMod": "< 1.27"
  },
  "constraintsVersioning": {
    "go": "npm",
    "%goMod": "npm"
  },
  "packageRules": [
    {
      "matchFileNames": [
        ".github/**",
        ".pre-commit-config.yaml"
      ],
      "additionalBranchPrefix": "",
      "groupName": "ci deps",
      "extends": [
        ":semanticCommitTypeAll(chore)",
        ":rebaseStalePrs"
      ]
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepNames": [
        "google",
        "google-beta"
      ],
      "additionalBranchPrefix": "",
      "groupName": "terraform google provider",
      "rangeStrategy": "widen"
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "constraintsFiltering": "strict",
      "postUpdateOptions": [
        "gomodTidy",
        "gomodUpdateImportPaths"
      ]
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "golang-version"
      ],
      "rangeStrategy": "replace",
      "allowedVersions": "< 1.27"
    },
    {
      "matchCategories": [
        "golang",
        "python",
        "js",
        "docker",
        "ruby",
        "java",
        "kubernetes"
      ],
      "additionalBranchPrefix": "",
      "groupName": "{{#if packageFileDir}}{{{packageFileDir}}} deps{{else}}root deps{{/if}}",
      "groupSlug": "{{#if packageFileDir}}{{{packageFileDir}}}-deps{{else}}root-deps{{/if}}"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "additionalBranchPrefix": "",
      "groupName": "{{#if packageFileDir}}{{{packageFileDir}}} deps{{else}}root deps{{/if}}",
      "groupSlug": "{{#if packageFileDir}}{{{packageFileDir}}}-deps{{else}}root-deps{{/if}}"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "cft/developer-tools"
      ],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "ALPINE_VERSION := (?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "DOCKER_TAG_VERSION_DEVELOPER_TOOLS := (?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://gcr.io/cloud-foundation-cicd",
      "depNameTemplate": "cft/developer-tools"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)build/.*\\.cloudbuild(\\.[^/]+)?\\.ya?ml$/"
      ],
      "matchStrings": [
        "  _DOCKER_TAG_VERSION_DEVELOPER_TOOLS: ['\"]?(?<currentValue>[^'\"\\s]+)['\"]?\\s*\\n"
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://gcr.io/cloud-foundation-cicd",
      "depNameTemplate": "cft/developer-tools"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "GOLANGCI_VERSION := (?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "golangci/golangci-lint",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
