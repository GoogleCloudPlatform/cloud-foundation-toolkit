# NOTE: This file is automatically generated from values at:
# https://github.com/GoogleCloudPlatform/cloud-foundation-toolkit/blob/main/infra/terraform/test-org/org/locals.tf

name: 'lint'

on:
  workflow_dispatch:
  pull_request:
    types: [opened, edited, reopened, synchronize]
    branches: [${branch}]

permissions:
  contents: read

concurrency:
  group: '$${{ github.workflow }}-$${{ github.head_ref || github.ref }}'
  cancel-in-progress: true

jobs:
  lint:
    name: 'lint'
    runs-on: 'ubuntu-latest'
    timeout-minutes: 60
    steps:
      - uses: 'actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1' # v7.0.1
        with:
          persist-credentials: false
      - id: variables
        run: |
          MAKEFILE=$(find . -name Makefile -print -quit)
          if [ -z "$MAKEFILE" ]; then
            echo dev-tools=gcr.io/cloud-foundation-cicd/cft/developer-tools:1 >> "$GITHUB_OUTPUT"
          else
            VERSION=$(sed -n 's/^DOCKER_TAG_VERSION_DEVELOPER_TOOLS[[:space:]]*[:?]*=[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$MAKEFILE" | head -n1)
            IMAGE=$(sed -n 's/^DOCKER_IMAGE_DEVELOPER_TOOLS[[:space:]]*[:?]*=[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$MAKEFILE" | head -n1)
            REGISTRY=$(sed -n 's/^REGISTRY_URL[[:space:]]*[:?]*=[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$MAKEFILE" | head -n1)
            case "$REGISTRY" in
              gcr.io/cloud-foundation-cicd|us-docker.pkg.dev/cloud-foundation-cicd/gcr.io) ;;
              *)
                echo "Error: Unsupported REGISTRY_URL '$REGISTRY' in $MAKEFILE" >&2
                exit 1
                ;;
            esac
            IMAGE_REGEX='^cft/developer-tools(-krm|-light|-jenkins)?$'
            if [[ ! "$IMAGE" =~ $IMAGE_REGEX ]]; then
              echo "Error: Unsupported DOCKER_IMAGE_DEVELOPER_TOOLS '$IMAGE' in $MAKEFILE" >&2
              exit 1
            fi
            VERSION_REGEX='^v?[0-9]+(\.[0-9]+){0,2}([+-][A-Za-z0-9._-]+)?(@sha256:[a-f0-9]{64})?$'
            if [[ ! "$VERSION" =~ $VERSION_REGEX ]]; then
              echo "Error: Invalid DOCKER_TAG_VERSION_DEVELOPER_TOOLS '$VERSION' in $MAKEFILE" >&2
              exit 1
            fi
            echo dev-tools=$${REGISTRY}/$${IMAGE}:$${VERSION} >> "$GITHUB_OUTPUT"
          fi
      - run: docker run --rm %{if lint_env != null }%{ for key, value in lint_env ~}-e ${key} %{ endfor ~}%{ endif }-v "$GITHUB_WORKSPACE":/workspace "$STEPS_VARIABLES_OUTPUTS_DEV_TOOLS" module-swapper
        env:
%{ if lint_env != null ~}%{ for key, value in lint_env ~}
          ${key}: ${value}
%{ endfor ~}%{ endif ~}
          STEPS_VARIABLES_OUTPUTS_DEV_TOOLS: $${{ steps.variables.outputs.dev-tools }}
      - run: docker run --rm %{if lint_env != null }%{ for key, value in lint_env ~}-e ${key} %{ endfor ~}%{ endif }-v "$GITHUB_WORKSPACE":/workspace "$STEPS_VARIABLES_OUTPUTS_DEV_TOOLS" /usr/local/bin/test_lint.sh
        env:
%{ if lint_env != null ~}%{ for key, value in lint_env ~}
          ${key}: ${value}
%{ endfor ~}%{ endif ~}
          STEPS_VARIABLES_OUTPUTS_DEV_TOOLS: $${{ steps.variables.outputs.dev-tools }}
  commitlint:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Setup node
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: lts/*
      - name: Install commitlint
        run: |
          npm install -D @commitlint/cli@20.2.0 @commitlint/config-conventional@20.2.0
          echo "module.exports = { extends: ['@commitlint/config-conventional'], rules: {'subject-case': [0], 'header-max-length': [0]} };" > commitlint.config.js
          npx commitlint --version
      - name: Validate PR commits with commitlint
        env:
          TITLE: $${{ github.event.pull_request.title }}
        run: 'echo "$TITLE" | npx commitlint --verbose'
